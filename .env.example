# Copy to .env and fill in. Never commit .env.

# --- Required for the live demo ---
ANTHROPIC_API_KEY=
LLM_MODEL=sonnet-5-5
AGENTVERSE_API_KEY=

# Agent seeds: set your OWN long random strings. Anyone who knows a seed controls that agent.
ORCHESTRATOR_SEED=
KNOWLEDGE_SEED=
ROUTING_SEED=
MANAGER_SEED=
INSIGHTS_SEED=

# --- Manager approval gate ---
# The manager's ASI:One address(es), comma-separated. If empty, anyone can act as the manager (demo mode).
MANAGER_ALLOWED_SENDERS=
# Optional: push new approval requests to this address as a card.
MANAGER_CHAT_ADDRESS=

# --- Real email after approval (optional) ---
# Without SMTP, approved emails are saved to /outbox and the reply says "Simulated".
# Gmail: use an app password, host smtp.gmail.com, port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Send every email to one inbox you control (recommended for the live demo).
DEMO_RECIPIENT_OVERRIDE=

# --- Payments ---
INSIGHTS_PRICE_FET=0.1
FET_USE_TESTNET=true

# --- Options ---
# anthropic (default) or extractive (no model; quotes docs directly)
UNBLOCK_LLM=anthropic
# Pin "today" so doc freshness is repeatable in demos
UNBLOCK_TODAY=2026-10-17
UNBLOCK_CARDS=true
